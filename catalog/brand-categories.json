  "metadata": {
    "catalogId": "bg-beta-brand-registry",
    "locale": "bg-BG",
    "lastReviewed": "2026-07-20",
    "reviewCycle": "quarterly",
    "defaultCurrency": "EUR",
    "selectionPolicy": "Curated Bulgarian launch catalogue. Category lists are alphabetical relevance sets, not numerical popularity rankings. Audience belongs to the individual fragrance, not permanently to the brand.",
    "collectionSemantics": "Editorial discovery collections only. A collection membership never auto-assigns an audience or segment to a listing.",
    "supportedAliasTypes": [
      "searchAlias",
      "formerName",
      "misspelling",
      "transliteration",
      "productLine"
    ],
    "normalization": {
      "unicodeForm": "NFKC",
      "caseFold": true,
      "collapseWhitespace": true,
      "stripDiacriticsForSearch": true
    },
    "provenance": {
      "method": "manual_editorial_curation",
      "sourceCatalogVersion": 1,
      "externalImports": false,
      "scraping": false
    }
  },
  "otherBrandPolicy": {
    "enabled": true,
    "label": "Други",
    "minLength": 2,
    "maxLength": 80,
    "publication": "immediate",
    "moderationState": "pending_canonicalization",
    "captureFields": [
      "originalInput",
      "normalizedKey",
      "suggestedBrandId",
      "provenance",
      "auditTrail"
    ],
    "auditTrailRequired": true
  },
