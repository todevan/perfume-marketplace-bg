# Runtime mode. Production must leave demo mode false.
PUBLIC_DEMO_MODE=false
APP_ENV=development

# Public Supabase project values. New projects should use the publishable key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy local-project compatibility only.
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_APP_URL=http://localhost:5173

# Server-only Supabase access. Never expose either value to browser code.
SUPABASE_SECRET_KEY=
# Legacy hosted/local-project compatibility only.
SUPABASE_SERVICE_ROLE_KEY=

# Closed-beta policy and consent versions
PRIVATE_BETA_REQUIRE_INVITE=true
PRIVATE_BETA_REQUIRE_STAFF_MFA=true
TERMS_VERSION=beta-2026-07
PRIVACY_VERSION=beta-2026-07
MARKETPLACE_RULES_VERSION=beta-2026-07
LEGAL_CONTENT_APPROVED=false
INCIDENT_CONTACT_EMAIL=
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_REGISTRATION=
LEGAL_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
APPEALS_CONTACT_EMAIL=
LEGAL_APPROVAL_REFERENCE=
EXPECTED_PRODUCTION_APP_HOST=

# Notifications / abuse prevention
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_WEBHOOK_SECRET=
# Dedicated raw-body signature verification for downstream Resend events.
RESEND_WEBHOOK_SECRET=
# Read-only monitor credential: long random 43-128 character base64url value.
# Never provide a Supabase administrator credential to Grafana.
OPERATIONS_MONITOR_TOKEN=
OPERATIONS_EXPECTED_DEPLOYMENT_SHA=
OPERATIONS_EXPECTED_MIGRATION_DIGEST=
OPERATIONS_EXPECTED_SCHEMA_DIGEST=
# One synthetic object in the private operations-sentinels bucket; never log its path.
OPERATIONS_SENTINEL_PATH=
OPERATIONS_SENTINEL_SHA256=
OPERATIONS_SAFETY_WARNING_HOURS=24
OPERATIONS_SAFETY_CRITICAL_HOURS=48
# Exact daily canary deadline in UTC HH:MM; no implicit schedule.
OPERATIONS_CANARY_EXPECTED_UTC=
UPLOAD_CLEANUP_SECRET=
UPLOAD_CLEANUP_BATCH_SIZE=25
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Trusted local operator only; never configure these as Worker variables.
# Keep disabled until hosted Auth email transport has been verified.
FIRST_ADMIN_BOOTSTRAP_ENABLED=false
FIRST_ADMIN_EMAIL_TRANSPORT_CONFIRMED=false
FIRST_ADMIN_EMAIL=
# Required only for a deterministic `bootstrap:first-admin -- bind` retry.
FIRST_ADMIN_BOOTSTRAP_INVITE_ID=
FIRST_ADMIN_BOOTSTRAP_USER_ID=

# SMS is configured in Supabase Auth. These names are consumed by local config/ops only.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Trusted image finalization. Keep disabled until a Cloudflare Images binding is configured.
# Use cloudflare-images only after the private original -> sanitized derivative flow is configured.
IMAGE_PROCESSOR_MODE=disabled
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
FINALIZED_IMAGE_BUCKET=listing-images
# Used only by the offline storage backup scripts; never configure it as a Worker secret.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=.backups
# Required by every backup/restore invocation and matched against PUBLIC_SUPABASE_URL.
EXPECTED_SUPABASE_PROJECT_REF=
STAGING_INVENTORY_RECEIPT_PATH=
STAGING_INVENTORY_RECEIPT_SHA256=
# Production receipts are JSON artifacts generated for the exact release commit.
RELEASE_COMMIT_SHA=
HOSTED_RUNTIME_INVENTORY_RECEIPT_PATH=
HOSTED_CRON_INVENTORY_SHA256=
PROVIDER_ATTESTATION_RECEIPT_PATH=
PROVIDER_ATTESTATION_SHA256=
# Issue 29: one sanitized, hash-bound receipt plus private mode-0600 evidence files.
# Keep the evidence directory outside the repository; filenames are <sha256>.json.
RELEASE_TREE_SHA=
RELEASE_WORKER_VERSION=
OPERATIONS_READINESS_RECEIPT_PATH=
OPERATIONS_READINESS_RECEIPT_SHA256=
OPERATIONS_EVIDENCE_DIRECTORY=
OPERATIONS_MONITOR_CONFIG_SHA256=
OPERATIONS_ISOLATION_MATRIX_SHA256=

# Closed-beta defaults: all monetisation remains off.
FEATURE_BILLING_ENABLED=false
FEATURE_LISTING_FEES_ENABLED=false
FEATURE_MERCHANT_SUBSCRIPTIONS_ENABLED=false
FEATURE_BOOSTS_ENABLED=false
FEATURE_DIRECT_ADS_ENABLED=false
FEATURE_SMS_VERIFICATION_ENABLED=false
FEATURE_MYPOS_PAYMENTS_ENABLED=false
FEATURE_STRIPE_FALLBACK_ENABLED=false
PAYMENT_PROVIDER=disabled

# Populate only after legal/accounting approval and sandbox verification.
MYPOS_SID=
MYPOS_WALLET_NUMBER=
MYPOS_KEY_INDEX=
MYPOS_CHECKOUT_URL=
MYPOS_PRIVATE_KEY=
MYPOS_PUBLIC_CERTIFICATE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
